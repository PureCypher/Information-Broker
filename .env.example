# Information Broker - Environment Configuration Template
# Copy this file to .env and customize the values for your deployment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_this_secure_password_in_production
DB_NAME=information_broker

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_PORT=8080
RSS_FETCH_INTERVAL=30m
RSS_FEEDS_FILE=/app/feeds.txt
LOG_LEVEL=info

# Initiation date - articles published before this date will be ignored
# Format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SSZ
# Default: 2020-01-01 (if not specified)
APP_INITIATION_DATE=2025-05-31

# Article cutoff date - only articles published on or after this date will be processed
# Format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SSZ
# Default: 2025-05-31T00:00:00Z (articles published from May 31, 2025 onwards)
ARTICLE_CUTOFF_DATE=2025-05-31T00:00:00Z

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_TIMEOUT=30s
API_USER_AGENT=Information-Broker/1.0

# =============================================================================
# LLAMA.CPP SERVICES (docker compose: llama-granite on the GPU, llama-embed on the CPU)
# Summarizer server (/v1/chat/completions) and embedding server (/embedding)
LLAMA_URL=http://llama-granite:8080
LLAMA_EMBED_URL=http://llama-embed:8081
# Name reported in logs; the server serves whichever GGUF it was started with
LLAMA_MODEL=granite-4.2-3b
# Timeout and retries for summary requests
LLAMA_TIMEOUT=60s
LLAMA_MAX_RETRIES=3
# Cap on generated tokens per summary
LLAMA_MAX_TOKENS=512
# Host directory holding the GGUF files, and their names
MODELS_DIR=./models
LLAMA_MODEL_FILE=granite-4.2-3b-Q4_K_M.gguf
LLAMA_EMBED_MODEL_FILE=nomic-embed-text-v1.5.f16.gguf
# Group ids of "render" and "video" on the host (getent group render video)
RENDER_GID=993
VIDEO_GID=44

# =============================================================================
# DISCORD WEBHOOK CONFIGURATION (Optional)
# =============================================================================
# Option 1: Single webhook URL (backward compatibility)
DISCORD_WEBHOOK_URL=

# Option 2: Multiple webhook URLs (comma-separated for multi-cast notifications)
# Example: DISCORD_WEBHOOK_URLS=https://discord.com/api/webhooks/1234/token1,https://discord.com/api/webhooks/5678/token2
DISCORD_WEBHOOK_URLS=

# Discord webhook configuration
DISCORD_MAX_RETRIES=2
DISCORD_TIMEOUT=30s

# Onboard new feeds without flooding Discord (temporary; leave empty normally).
# Articles from matching feeds ingested before DISCORD_SILENT_UNTIL are stored as
# already posted, so the summarizer never announces them. RFC3339 only.
# Example: DISCORD_SILENT_FEEDS=aikido.dev,bishopfox.com
#          DISCORD_SILENT_UNTIL=2026-10-29T12:00:00Z
DISCORD_SILENT_FEEDS=
DISCORD_SILENT_UNTIL=

# =============================================================================
# PROMETHEUS MONITORING CONFIGURATION
# =============================================================================
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=90d
PROMETHEUS_LOG_LEVEL=info
PROMETHEUS_URL=http://prometheus:9090

# =============================================================================
# ALERTING CONFIGURATION
# =============================================================================
ALERTMANAGER_PORT=9093
SLACK_WEBHOOK_URL=

# =============================================================================
# EXTERNAL GRAFANA
# =============================================================================
# Grafana is not part of this stack. Prometheus forwards this service's metrics to
# the Prometheus behind your Grafana with remote_write (see prometheus.yml), and the
# dashboard in grafana/dashboards is imported there
# (see docs/grafana-operations-overview.md).

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
MAX_CONCURRENT_FEEDS=10
MAX_ARTICLE_CONTENT_LENGTH=10000
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# =============================================================================
# CONTENT PROCESSING CONFIGURATION
# =============================================================================
MAX_SUMMARY_LENGTH=200
CONTENT_HASH_ALGORITHM=sha256

# =============================================================================
# SUMMARIZATION SCHEDULER CONFIGURATION
# =============================================================================
SUMMARIZATION_MAX_QUEUE_SIZE=100
SUMMARIZATION_WORKER_TIMEOUT=120s
SUMMARIZATION_MAX_RETRIES=3
SUMMARIZATION_RETRY_BACKOFF_BASE=1s
SUMMARIZATION_METRICS_INTERVAL=10s
SUMMARIZATION_QUEUE_PURGE_TIMEOUT=1h

# =============================================================================
# PRODUCTION SECURITY NOTES
# =============================================================================
# 1. Change all default passwords
# 2. Generate strong random secret keys
# 3. Restrict CORS_ALLOWED_ORIGINS in production
# 4. Use HTTPS with a reverse proxy
# 5. Implement proper network segmentation
# 6. Enable firewall rules
# 7. Regular security updates